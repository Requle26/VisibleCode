{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/trace.js": { "maxDuration": 30, "supportsCancellation": true } },
  "rewrites": [
    { "source": "/csharp", "destination": "/index.html" },
    { "source": "/python", "destination": "/index.html" }
  ]
}
